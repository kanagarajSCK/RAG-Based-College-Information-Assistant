# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Frontend URL(s), comma-separated when more than one origin is needed.
FRONTEND_URL="https://your-frontend.vercel.app"

# Frontend-only variable. Set this in Vercel to your Render API URL.
VITE_API_URL="https://your-backend.onrender.com"

# JWT Secret for signing authentication tokens
JWT_SECRET="campusiq_production_jwt_secret_key_2026"

# MongoDB connection string (Optional: uses built-in persistent disk JSON/indexed vector store by default)
MONGODB_URI=""

# AI Models configuration
AI_MODEL="gemini-3.7-flash"
EMBEDDING_MODEL="gemini-embedding-2-preview"

# Port configuration
PORT=3000

